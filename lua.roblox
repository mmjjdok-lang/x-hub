local windUiSourceUrl = "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
local windUiSource

local sourceOk, sourceResult = pcall(function()
    return game:HttpGet(windUiSourceUrl)
end)

if not sourceOk or type(sourceResult) ~= "string" or sourceResult == "" then
    warn("Eclipse X: تعذر تحميل WindUI: " .. tostring(sourceResult))
    return
end

local compileOk, compiledWindUI = pcall(loadstring, sourceResult)
if not compileOk or type(compiledWindUI) ~= "function" then
    warn("Eclipse X: تعذر ترجمة WindUI: " .. tostring(compiledWindUI))
    return
end

local runOk, WindUIResult = pcall(compiledWindUI)
if not runOk or type(WindUIResult) ~= "table" then
    warn("Eclipse X: تعذر تشغيل WindUI: " .. tostring(WindUIResult))
    return
end

windUiSource = sourceResult
local WindUI = WindUIResult

