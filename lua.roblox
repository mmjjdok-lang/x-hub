-- =======================================================
-- ميزة تعديل سرعة اللاعب (سلايدر + زر تفعيل Toggle)
-- =======================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- متغيرات السرعة والحالة
local selectedWalkSpeed = 16 -- القيمة الافتراضية للسرعة
local isSpeedEnabled = false

-- 1. سلايدر لاختيار الرقم (من 1 إلى 1000)
MainSection:Slider({
    Title = "speed slider",
    Min = 1,
    Max = 1000,
    Default = 16,
    Increment = 1,
    Callback = function(value)
        selectedWalkSpeed = value
        
        -- إذا كان زر التفعيل (Toggle) شغَالاً، قم بتطبيق السرعة فوراً عند تحريك السلايدر
        if isSpeedEnabled then
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = selectedWalkSpeed
                end
            end
        end
    end
})

-- 2. زر تشغيل (Toggle) لتفعيل أو إيقاف السرعة المحددة
MainSection:Toggle({
    Title = "speed palyer",
    Value = false,
    Callback = function(Value)
        isSpeedEnabled = Value
        
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if isSpeedEnabled then
                    humanoid.WalkSpeed = selectedWalkSpeed
                else
                    humanoid.WalkSpeed = 16 -- العودة للسرعة الافتراضية عند الإغلاق
                end
            end
        end
    end
})

-- دالة للحفاظ على السرعة مفعلة حتى لو مات اللاعب (Respawn)
LocalPlayer.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid")
    
    if isSpeedEnabled then
        humanoid.WalkSpeed = selectedWalkSpeed
    end
    
    -- مراقبة أي محاولة من اللعبة لتغيير السرعة وإبقائها على الرقم المختار
    humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if isSpeedEnabled and humanoid.WalkSpeed ~= selectedWalkSpeed then
            humanoid.WalkSpeed = selectedWalkSpeed
        end
    end)
end)

-- تطبيق الحماية على الشخصية الحالية إن وجدت
if LocalPlayer.Character then
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if isSpeedEnabled and humanoid.WalkSpeed ~= selectedWalkSpeed then
                humanoid.WalkSpeed = selectedWalkSpeed
            end
        end)
    end
end

-- =======================================================
-- ميزة الجدارن المخترقة (Noclip) مع زر تشغيل (Toggle)
-- =======================================================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local noclipConnection = nil

MainSection:Toggle({
    Title = " (Noclip)",
    Value = false,
    Callback = function(Value)
        if Value then
            -- تفعيل النوكليب
            noclipConnection = RunService.Stepped:Connect(function()
                local character = LocalPlayer.Character
                if character then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        else
            -- إيقاف النوكليب وإرجاع الاصطدام لطبيعته
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            
            local character = LocalPlayer.Character
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        -- ملاحظة: الأجزاء الأساسية مثل HumanoidRootPart عادة تكون CanCollide بـ true أو false حسب اللعبة
                        -- لكن الأفضل إرجاعها للطبيعي أو ترك اللعبة تديرها عند الموت والريسباون
                    end
                end
            end
        end
    end
})

-- =======================================================
-- ميزة الإخفاء (Invisible) مع زر تشغيل (Toggle)
-- =======================================================
local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")

-- المتغيرات الأساسية
local invisible = false
local character, humanoid, rootPart
local parts = {}
local invisConnection = nil

-- دالة تجهيز شخصيتك وجلب أجزاء جسمك
local function setupCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
    parts = {}
    for _, obj in pairs(character:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency == 0 then
            table.insert(parts, obj)
        end
    end
end

setupCharacter()

-- تحديث الشخصية لو صار رسبون
player.CharacterAdded:Connect(function()
    invisible = false
    if invisConnection then
        invisConnection:Disconnect()
        invisConnection = nil
    end
    task.wait(0.5)
    setupCharacter()
end)

-- إضافة ميزة الإخفاء داخل زر التبديل (Toggle)
MainSection:Toggle({
    Title = "(Invisible)",
    Value = false,
    Callback = function(Value)
        invisible = Value
        
        if invisible then
            -- 1. تفعيل الشفافية الخفيفة عشان تشوف نفسك والباقين ما يشوفونك
            for _, part in pairs(parts) do
                if part and part.Parent then
                    part.Transparency = 0.3
                end
            end
            
            -- 2. تشغيل قلب الإخفاء الخارق (Heartbeat) عشان تطير عن عيون السيرفر واللاعبين
            invisConnection = runService.Heartbeat:Connect(function()
                if invisible and rootPart and humanoid and rootPart.Parent then
                    local cf = rootPart.CFrame
                    local camOffset = humanoid.CameraOffset
                    
                    -- نقل الشخصية لمكان بعيد تحت الأرض في كل جزء من الثانية
                    local hidden = cf * CFrame.new(0, -200000, 0)
                    rootPart.CFrame = hidden
                    humanoid.CameraOffset = hidden:ToObjectSpace(CFrame.new(cf.Position)).Position
                    
                    runService.RenderStepped:Wait()
                    
                    -- إرجاع الموضع والكاميرا للحركة السلسة
                    if rootPart and rootPart.Parent then
                        rootPart.CFrame = cf
                        humanoid.CameraOffset = camOffset
                    end
                end
            end)
            
            print("Invisible: ON")
        else
            -- إيقاف الإخفاء وإرجاع كل شي طبيعي
            if invisConnection then
                invisConnection:Disconnect()
                invisConnection = nil
            end
            
            for _, part in pairs(parts) do
                if part and part.Parent then
                    part.Transparency = 0
                end
            end
            
            print("Invisible: OFF")
        end
    end
})

-- =======================================================
-- ميزة تعديل قوة القفز (سلايدر + زر تفعيل Toggle)
-- =======================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- متغيرات القفز والحالة
local selectedJumpPower = 50 -- القيمة الافتراضية لقوة القفز
local isJumpPowerEnabled = false

-- التأكد من أن اللعبة تستخدم JumpPower وليس JumpHeight
local function ensureJumpPowerType(humanoid)
    if humanoid then
        pcall(function()
            humanoid.UseJumpPower = true
        end)
    end
end

-- 1. سلايدر لاختيار قوة القفز (من 1 إلى 1000)
MainSection:Slider({
    Title = " (JumpPower)",
    Min = 1,
    Max = 1000,
    Default = 50,
    Increment = 1,
    Callback = function(value)
        selectedJumpPower = value
        
        -- إذا كان زر التفعيل (Toggle) شغَالاً، قم بتطبيق القوة فوراً عند تحريك السلايدر
        if isJumpPowerEnabled then
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    ensureJumpPowerType(humanoid)
                    humanoid.JumpPower = selectedJumpPower
                end
            end
        end
    end
})

-- 2. زر تشغيل (Toggle) لتفعيل أو إيقاف قوة القفز المحددة
MainSection:Toggle({
    Title = "JumpPower",
    Value = false,
    Callback = function(Value)
        isJumpPowerEnabled = Value
        
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                ensureJumpPowerType(humanoid)
                if isJumpPowerEnabled then
                    humanoid.JumpPower = selectedJumpPower
                else
                    humanoid.JumpPower = 50 -- العودة للقوة الافتراضية عند الإغلاق
                end
            end
        end
    end
})

-- دالة للحفاظ على القفز مفعلة حتى لو مات اللاعب (Respawn)
LocalPlayer.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid")
    ensureJumpPowerType(humanoid)
    
    if isJumpPowerEnabled then
        humanoid.JumpPower = selectedJumpPower
    end
    
    -- مراقبة أي محاولة من اللعبة لتغيير قوة القفز وإبقائها على الرقم المختار
    humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if isJumpPowerEnabled and humanoid.JumpPower ~= selectedJumpPower then
            humanoid.JumpPower = selectedJumpPower
        end
    end)
end)

-- تطبيق الحماية على الشخصية الحالية إن وجدت
if LocalPlayer.Character then
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        ensureJumpPowerType(humanoid)
        humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if isJumpPowerEnabled and humanoid.JumpPower ~= selectedJumpPower then
                humanoid.JumpPower = selectedJumpPower
            end
        end)
    end
end

-- =======================================================
-- حماية مطلقة ضد الفلنق (Anti-Fling & Anti-Push)
-- =======================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local antiFlingConnection = nil
local antiCollideConnection = nil

MainSection:Toggle({
    Title = "anti fling",
    Value = false,
    Callback = function(Value)
        if Value then
            -- 1. تفعيل حماية الاصطدام مع اللاعبين الآخرين (لمنع أي شخص من دفعك أو لمسك)
            antiCollideConnection = RunService.Stepped:Connect(function()
                local character = LocalPlayer.Character
                if character then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            -- منع أي جزء في جسمك من الاصطدام بأي لاعب آخر
                            part.CanCollide = true -- تبقى قادراً على الوقوف على الأرض والجدران
                            
                            -- تعطيل التلامس الفيزيائي مع اللاعبين الآخرين فقط
                            for _, player in ipairs(Players:GetPlayers()) do
                                if player ~= LocalPlayer and player.Character then
                                    for _, pPart in ipairs(player.Character:GetDescendants()) do
                                        if pPart:IsA("BasePart") then
                                            pcall(function()
                                                local constraint = part:FindFirstChild("NoCollisionConstraint")
                                                -- إيقاف الاصطدام المباشر تلقائياً
                                                part.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)

            -- 2. حماية الفلنق الخارقة (تثبيت السرعة والقضاء على أي قوة دفع وهمية)
            antiFlingConnection = RunService.Heartbeat:Connect(function()
                local character = LocalPlayer.Character
                if character then
                    local rootPart = character:FindFirstChild("HumanoidRootPart")
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    
                    if rootPart and humanoid then
                        -- إيقاف أي سرعة دوران مجنونة أو سرعة دفع خيالية (حتى لو مليار)
                        if rootPart.Velocity.Magnitude > 100 or rootPart.RotVelocity.Magnitude > 100 then
                            rootPart.Velocity = Vector3.new(0, 0, 0)
                            rootPart.RotVelocity = Vector3.new(0, 0, 0)
                        end
                        
                        -- إلغاء أي قوى دفع خارجية (BodyForces / BodyVelocity) قد يزرعها شخص فيك
                        for _, child in ipairs(rootPart:GetChildren()) do
                            if child:IsA("BodyVelocity") or child:IsA("BodyForce") or child:IsA("BodyThrust") or child:IsA("RocketPropulsion") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end)
            
            print("Anti-Fling & Push: ON")
        else
            -- إيقاف الحماية وإرجاع الأمور لطبيعتها
            if antiCollideConnection then
                antiCollideConnection:Disconnect()
                antiCollideConnection = nil
            end
            
            if antiFlingConnection then
                antiFlingConnection:Disconnect()
                antiFlingConnection = nil
            end
            
            print("Anti-Fling & Push: OFF")
        end
    end
})

-- =======================================================
-- ميزة كشف الأدوار والـ ESP (Murderer / Sheriff / Innocent)
-- =======================================================
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local ParentContainer = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")

local ESPData = {
    Highlights = {},
    Connection = nil,
    PlayerEvents = {}
}

local RoleColors = {
    Murderer = Color3.fromRGB(255, 0, 0),    -- أحمر قوي
    Sheriff  = Color3.fromRGB(0, 120, 255),   -- أزرق قوي
    Innocent = Color3.fromRGB(0, 255, 80)    -- أخضر قوي
}

local function removePlayerESP(player)
    if ESPData.Highlights[player] then
        ESPData.Highlights[player]:Destroy()
        ESPData.Highlights[player] = nil
    end
end

local function getRole(player)
    if not player then return "Innocent" end

    local serverRoleObj = player:FindFirstChild("ServerRole") or (player.Character and player.Character:FindFirstChild("ServerRole"))
    if serverRoleObj and serverRoleObj:IsA("ValueBase") then
        local val = tostring(serverRoleObj.Value)
        if RoleColors[val] then return val end
    end

    local attrRole = player:GetAttribute("ServerRole")
    if attrRole and RoleColors[tostring(attrRole)] then
        return tostring(attrRole)
    end

    local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if getPlayerData and getPlayerData:IsA("RemoteFunction") then
        local success, data = pcall(function() return getPlayerData:InvokeServer() end)
        if success and type(data) == "table" and data[player.Name] then
            local role = data[player.Name].Role
            if role == "Hero" then return "Sheriff" end
            if RoleColors[role] then return role end
        end
    end

    return "Innocent"
end

local function updateESP(player)
    if player == LocalPlayer then return end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not char or not hrp or not hum or hum.Health <= 0 then
        removePlayerESP(player)
        return
    end

    local role = getRole(player)
    local color = RoleColors[role] or RoleColors.Innocent

    local highlight = ESPData.Highlights[player]

    if not highlight or highlight.Parent ~= ParentContainer then
        removePlayerESP(player)
        
        highlight = Instance.new("Highlight")
        highlight.Name = "ESP_" .. player.Name
        highlight.FillTransparency = 0 
        highlight.OutlineTransparency = 0 
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) 
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = ParentContainer
        ESPData.Highlights[player] = highlight
    end

    highlight.Adornee = char
    highlight.FillColor = color
end

local function updateAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            updateESP(p)
        end
    end
end

local function listenToPlayer(player)
    if player == LocalPlayer then return end

    local function setupCharacter(char)
        removePlayerESP(player)
        
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            hum.Died:Connect(function()
                removePlayerESP(player)
            end)
        end

        updateESP(player)
    end

    if player.Character then setupCharacter(player.Character) end
    
    local conn1 = player.CharacterAdded:Connect(setupCharacter)
    local conn2 = player.ChildAdded:Connect(function(child)
        if child.Name == "ServerRole" then
            if child:IsA("ValueBase") then
                child.Changed:Connect(function() updateESP(player) end)
            end
            updateESP(player)
        end
    end)
    
    local conn3 = player.AncestryChanged:Connect(function()
        if not player:IsDescendantOf(game) then
            removePlayerESP(player)
        end
    end)

    ESPData.PlayerEvents[player] = {conn1, conn2, conn3}
end

-- ربط الميزة بـ زر التبديل (Toggle)
espSection:Toggle({
    Title = "(Role ESP)",
    Value = false,
    Callback = function(Value)
        if Value then
            -- تفعيل الكشف
            for _, player in ipairs(Players:GetPlayers()) do
                listenToPlayer(player)
            end

            Players.PlayerAdded:Connect(listenToPlayer)
            Players.PlayerRemoving:Connect(function(player)
                removePlayerESP(player)
                if ESPData.PlayerEvents[player] then
                    for _, conn in ipairs(ESPData.PlayerEvents[player]) do
                        conn:Disconnect()
                    end
                    ESPData.PlayerEvents[player] = nil
                end
            end)

            -- حلقة التحديث المستمرة
            ESPData.Connection = task.spawn(function()
                while task.wait(0.1) do
                    updateAllESP()
                end
            end)
            
            print("Role ESP: ON")
        else
            -- إيقاف الكشف وحذف جميع الـ Highlights الموجودة
            if ESPData.Connection then
                task.cancel(ESPData.Connection)
                ESPData.Connection = nil
            end

            for player, _ in pairs(ESPData.Highlights) do
                removePlayerESP(player)
            end

            print("Role ESP: OFF")
        end
    end
})

-- =======================================================
-- ميزة كشف الأسماء فقط (Name ESP) مع زر تشغيل (Toggle)
-- =======================================================
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local ParentContainer = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")

local ESPData = {
    Billboards = {},
    Connection = nil,
    PlayerEvents = {}
}

local function removePlayerESP(player)
    if ESPData.Billboards[player] then
        ESPData.Billboards[player]:Destroy()
        ESPData.Billboards[player] = nil
    end
end

local function updateESP(player)
    if player == LocalPlayer then return end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not char or not hrp or not head or not hum or hum.Health <= 0 then
        removePlayerESP(player)
        return
    end

    -- تحديث لوحة الاسم (BillboardGui) فوق رأس اللاعب
    local billboard = ESPData.Billboards[player]
    local textLabel
    if not billboard or billboard.Parent ~= ParentContainer then
        if billboard then billboard:Destroy() end

        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Name_" .. player.Name
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = ParentContainer

        textLabel = Instance.new("TextLabel")
        textLabel.Name = "NameText"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextScaled = false
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- لون أبيض صافي
        textLabel.TextStrokeTransparency = 0 -- حدود سوداء واضحة للنص
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.Parent = billboard

        ESPData.Billboards[player] = billboard
    else
        textLabel = billboard:FindFirstChild("NameText")
    end

    billboard.Adornee = head
    if textLabel then
        textLabel.Text = player.Name
    end
end

local function updateAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            updateESP(p)
        end
    end
end

local function listenToPlayer(player)
    if player == LocalPlayer then return end

    local function setupCharacter(char)
        removePlayerESP(player)
        
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            hum.Died:Connect(function()
                removePlayerESP(player)
            end)
        end

        updateESP(player)
    end

    if player.Character then setupCharacter(player.Character) end
    
    local conn1 = player.CharacterAdded:Connect(setupCharacter)
    local conn3 = player.AncestryChanged:Connect(function()
        if not player:IsDescendantOf(game) then
            removePlayerESP(player)
        end
    end)

    ESPData.PlayerEvents[player] = {conn1, conn3}
end

-- ربط الميزة بـ زر التبديل (Toggle)
espSection:Toggle({
    Title = " (Name ESP)",
    Value = false,
    Callback = function(Value)
        if Value then
            -- تفعيل الكشف
            for _, player in ipairs(Players:GetPlayers()) do
                listenToPlayer(player)
            end

            Players.PlayerAdded:Connect(listenToPlayer)
            Players.PlayerRemoving:Connect(function(player)
                removePlayerESP(player)
                if ESPData.PlayerEvents[player] then
                    for _, conn in ipairs(ESPData.PlayerEvents[player]) do
                        conn:Disconnect()
                    end
                    ESPData.PlayerEvents[player] = nil
                end
            end)

            -- حلقة التحديث المستمرة
            ESPData.Connection = task.spawn(function()
                while task.wait(0.1) do
                    updateAllESP()
                end
            end)
            
            print("Name ESP: ON")
        else
            -- إيقاف الكشف وحذف جميع الـ Billboards
            if ESPData.Connection then
                task.cancel(ESPData.Connection)
                ESPData.Connection = nil
            end

            for player, _ in pairs(ESPData.Billboards) do
                removePlayerESP(player)
            end

            print("Name ESP: OFF")
        end
    end
})

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local isCoinFarmActive = false
local farmConnection = nil
local maxCoins = 40
local farmSpeed = 200 -- القيمة الافتراضية للسرعة (يمكن تعديلها بالسايدر)

-- وظيفة التحقق من وجود القاتل على قيد الحياة بحوزته السكين
local function IsMurdererAlive()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local backpack = player:FindFirstChild("Backpack")
            local char = player.Character
            
            if humanoid and humanoid.Health > 0 then
                local hasKnife = (backpack and (backpack:FindFirstChild("Knife") or backpack:FindFirstChild("KnifeServer"))) 
                    or (char and (char:FindFirstChild("Knife") or char:FindFirstChild("KnifeServer")))
                
                if hasKnife then
                    return true
                end
            end
        end
    end
    return false
end

-- وظيفة زر الفارم
local function ToggleCoinFarm(State)
    isCoinFarmActive = State
    
    if isCoinFarmActive then
        local ignoredCoins = {}
        local collectedCount = 0
        
        farmConnection = task.spawn(function()
            while isCoinFarmActive do
                -- 1. التحقق من القاتل
                if not IsMurdererAlive() then
                    isCoinFarmActive = false
                    break
                end
                
                -- 2. التحقق من الوصول للحد الأقصى (40 كوينز)
                if collectedCount >= maxCoins then
                    isCoinFarmActive = false
                    break
                end
                
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                
                if root then
                    -- البحث عن أقرب كوين
                    local closestCoin = nil
                    local minDistance = math.huge
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name == "CoinVisual" or obj.Name == "Coin_server" or obj.Name == "Coin") then
                            if not ignoredCoins[obj] and obj.Parent then
                                local dist = (obj.Position - root.Position).Magnitude
                                if dist < minDistance then
                                    minDistance = dist
                                    closestCoin = obj
                                end
                            end
                        end
                    end
                    
                    if closestCoin then
                        -- الانتقال لنفس موقع الكوينز المباشر مع السرعة المحددة عبر السلايدر
                        local targetCFrame = CFrame.new(closestCoin.Position)
                        local distance = (targetCFrame.Position - root.Position).Magnitude
                        local duration = distance / math.max(farmSpeed, 1)
                        
                        local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                        tween:Play()
                        
                        -- الانتظار لحين الوصول أو تغير حالة الجولة
                        repeat 
                            task.wait() 
                        until not isCoinFarmActive or not IsMurdererAlive() or not closestCoin or not closestCoin.Parent or (root.Position - targetCFrame.Position).Magnitude < 1.5
                        
                        if closestCoin and isCoinFarmActive and IsMurdererAlive() then
                            if firetouchinterest then
                                pcall(function()
                                    firetouchinterest(root, closestCoin, 0)
                                    firetouchinterest(root, closestCoin, 1)
                                end)
                            end
                            collectedCount = collectedCount + 1
                            ignoredCoins[closestCoin] = true
                            task.wait(0.5)
                        end
                    else
                        table.clear(ignoredCoins)
                        task.wait(0.1)
                    end
                else
                    task.wait(0.5)
                end
            end
        end)
    else
        if farmConnection then
            task.cancel(farmConnection)
            farmConnection = nil
        end
    end
end

-- =======================================================
-- عناصر الواجهة (زر التشغيل + سلايدر السرعة)
-- =======================================================

-- 1. زر تفعيل الفارم
autofarmSection:Toggle({
    Title = "(Coin Farm)",
    Value = false,
    Callback = function(State)
        ToggleCoinFarm(State)
    end
})

-- 2. سلايدر التحكم في السرعة (من 1 إلى 200)
autofarmSection:Slider({
    Title = "farm speed",
    Min = 1,
    Max = 200,
    Default = 200,
    Increment = 1,
    Callback = function(Value)
        farmSpeed = Value -- تحديث متغير السرعة ديناميكياً عند تحريك السلايدر
    end
})
