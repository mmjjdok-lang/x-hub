-- تأثير قطرة الماء
local function CreateRipple(clickPosition)
    local btnAbsPos = button.AbsolutePosition
    local relativeX = clickPosition.X - btnAbsPos.X
    local relativeY = clickPosition.Y - btnAbsPos.Y

    local circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.new(0, relativeX, 0, relativeY)
    circle.Size = UDim2.new(0, 0, 0, 0)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BackgroundTransparency = 0.4
    circle.ZIndex = button.ZIndex + 2

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle
    circle.Parent = button

    local tweenInfo = TweenInfo.new(0.65, Enum.EasingStyle.OutQuart, Enum.EasingDirection.Out)
    local tween = TweenService:Create(circle, tweenInfo, {
        Size = UDim2.new(0, 220, 0, 220),
        BackgroundTransparency = 1
    })
    
    tween:Play()
    tween.Completed:Connect(function()
        circle:Destroy()
    end)
end

-- رسم شعاع الطلقة المضيء
local function CreateAdvancedTracer(startPos, targetPos)
    local p1 = Instance.new("Part")
    p1.Size = Vector3.new(0.05, 0.05, 0.05)
    p1.Transparency = 1
    p1.CanCollide = false
    p1.Anchored = true
    p1.Position = startPos
    p1.Parent = Workspace

    local p2 = Instance.new("Part")
    p2.Size = Vector3.new(0.05, 0.05, 0.05)
    p2.Transparency = 1
    p2.CanCollide = false
    p2.Anchored = true
    p2.Position = targetPos
    p2.Parent = Workspace

    local a1 = Instance.new("Attachment", p1)
    local a2 = Instance.new("Attachment", p2)

    local beam = Instance.new("Beam")
    beam.Attachment0 = a1
    beam.Attachment1 = a2
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Width0 = 0.4
    beam.Width1 = 0.4
    beam.FaceCamera = true
    beam.Parent = p1

    local tween = TweenService:Create(beam, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Width0 = 0,
        Width1 = 0
    })
    tween:Play()

    task.delay(0.15, function()
        p1:Destroy()
        p2:Destroy()
    end)
end

-- البحث عن القاتل
local function GetMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hasKnife = char:FindFirstChild("Knife") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife"))
            if hasKnife then
                return char
            end
        end
    end
    return nil
end

-- تطبيق الهيتبوكس المخفي على القاتل
local function ApplyCustomHitbox(murdererChar)
    local heartPart = murdererChar:FindFirstChild("UpperTorso") or murdererChar:FindFirstChild("HumanoidRootPart")
    if heartPart then
        heartPart.Size = Vector3.new(5, 5, 5)
        heartPart.Transparency = 1
        heartPart.CanCollide = false
    end
end

    local function ShootMurderer()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local gun = (character and (character:FindFirstChild("Gun") or character:FindFirstChild("Revolver")))
        or LocalPlayer.Backpack:FindFirstChild("Gun")
        or LocalPlayer.Backpack:FindFirstChild("Revolver")

    if not character or not humanoid or not gun then
        WindUI:Notify({
            Title = "Eclipse X",
            Content = "لم يتم العثور على المسدس أو الشخصية.",
            Duration = 3
        })
        return
    end

    -- تجهيز المسدس فوراً
    if gun.Parent == LocalPlayer.Backpack then
        humanoid:EquipTool(gun)
    end

    -- الانتظار 0.1 ثانية
    task.wait(0.1)

    local murdererChar = GetMurderer()
    if murdererChar then
        ApplyCustomHitbox(murdererChar)

        local heartPart = murdererChar:FindFirstChild("UpperTorso") or murdererChar:FindFirstChild("HumanoidRootPart")
        local myRoot = character:FindFirstChild("HumanoidRootPart")

        if heartPart and myRoot then
            local shootRemote = gun:FindFirstChild("Shoot")
            if shootRemote and shootRemote:IsA("RemoteEvent") then
                local murdererCFrame = heartPart.CFrame
                
               
                -- إظهار الشعاع المضيء
                CreateAdvancedTracer(myRoot.Position + Vector3.new(0, 1.5, 0), murdererCFrame.Position)

                                -- إرسال الريموت باستخدام اتجاه اللاعب الحالي
                local aimCFrame = myRoot.CFrame
                shootRemote:FireServer(aimCFrame, murdererCFrame)
            end
        end
    end

    -- إرجاع المسدس فوراً للحقيبة
    humanoid:UnequipTools()
end
WindUI:Notify({
            Title = " Eclipse X",
            Content = "The Murder was launched successfully.!",
            Duration = 3
        })
    end
})
