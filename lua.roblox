-- التحكم بالضغط والسحب للزر
-- =======================================================
local dragging = false
local activeInput = nil
local dragStart = nil
local startPos = nil
local hasDraggedFar = false

button.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not dragging then
        dragging = true
        activeInput = input
        dragStart = input.Position
        startPos = button.Position
        hasDraggedFar = false

        TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 38, 0, 38)
        }):Play()

        CreateRipple(input.Position)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == activeInput then
        local delta = input.Position - dragStart
        if delta.Magnitude > 8 then
            hasDraggedFar = true
        end
        
        local targetPos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        
        TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
            Position = targetPos
        }):Play()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == activeInput and dragging then
        dragging = false
        activeInput = nil

        TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 45, 0, 45)
        }):Play()

        if not hasDraggedFar then
            task.spawn(ExecuteStealGun)
        end
    end
end)
        else
            -- [ عند إيقاف الـ Toggle: حذف الزر العائم وإيقاف العمليات ]
            print("تم إيقاف ميزة سرقة المسدس")
            
            if playerGui:FindFirstChild("StealGunButtonGui") then
                playerGui.StealGunButtonGui:Destroy()
            end
        end
    end
})

-- متغير عام لحفظ حالة واجهة فلنق الشريف
local flingSheriffConnection = nil

buttonSection:Toggle({
        Title = "button fling Sheriff",
    Value = false,
    Callback = function(Value)
        if Value then
            -- Services
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

-- حذف الواجهة القديمة للزر إن وجدت
if playerGui:FindFirstChild("FlingSheriffButtonGui") then
    playerGui.FlingSheriffButtonGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FlingSheriffButtonGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- إنشاء زر fling sheriff
local button = Instance.new("TextButton")
button.Name = "FlingSheriffBtn"
button.Size = UDim2.new(0, 45, 0, 45)
button.Position = UDim2.new(0, 125, 0, 20) -- موقع مناسب بجانب الأزرار الأخرى
button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
button.BackgroundTransparency = 0.85
button.Text = "fling\nsheriff"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 8
button.Font = Enum.Font.Jura
button.TextWrapped = true
button.ClipsDescendants = true
button.AutoButtonColor = false
button.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(1, 0)
uiCorner.Parent = button

local uiStroke = Instance.new("UIStroke")
uiStroke.Thickness = 2.5
uiStroke.Color = Color3.fromRGB(0, 255, 127)
uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
uiStroke.Parent = button

local uiGradient = Instance.new("UIGradient")
uiGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 127)),
    ColorSequenceKeypoint.new(0.3, Color3.fromRGB(170, 0, 255)),
    ColorSequenceKeypoint.new(0.7, Color3.fromRGB(220, 80, 255)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 127))
})
uiGradient.Rotation = 0
uiGradient.Parent = uiStroke

-- دوران التدرج
task.spawn(function()
    while button and button.Parent do
        local tween = game:GetService("TweenService"):Create(uiGradient, TweenInfo.new(7, Enum.EasingStyle.Linear), {Rotation = uiGradient.Rotation + 360})
        tween:Play()
        tween.Completed:Wait()
        if uiGradient.Rotation >= 360 then uiGradient.Rotation = 0 end
    end
end)

-- تأثير الضغط
local function CreateRipple(clickPosition)
    local btnAbsPos = button.AbsolutePosition
    local relativeX = clickPosition.X - btnAbsPos.X
    local relativeY = clickPosition.Y - btnAbsPos.Y

    local circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.new(0, relativeX, 0, relativeY)
    circle.Size = UDim2.new(0, 0, 0, 0)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BackgroundTransparency = 0.4
    circle.ZIndex = button.ZIndex + 2

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle
    circle.Parent = button

    local tween = game:GetService("TweenService"):Create(circle, TweenInfo.new(0.35, Enum.EasingStyle.OutQuart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 70, 0, 70),
        BackgroundTransparency = 1
    })
    
    tween:Play()
    tween.Completed:Connect(function()
        circle:Destroy()
    end)
end

-- =======================================================
-- وظيفة البحث عن الشريف والفلنق الخارق
-- =======================================================
local function GetSheriff()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local backpack = player:FindFirstChild("Backpack")
            local char = player.Character
            -- فحص وجود المسدس مع الشريف
            local hasGun = (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or 
                           (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver"))))
            if hasGun then
                return player
            end
        end
    end
    return nil
end

local function ExecuteFlingSheriff()
    local playerToFling = GetSheriff()

    if not playerToFling then
        if fu and fu.notification then
            fu.notification("Sheriff not found or hasn't spawned with the gun yet.")
        else
            warn("Sheriff not found or hasn't spawned with the gun yet.")
        end
        return
    end

    if getgenv and getgenv().antiFling then
        WindUI:Notify({
            Title = "Eclipse X",
            Content = "Turn off anti-fling to use fling.",
            Duration = 3
        })
        return
    end

    local player = Players.LocalPlayer
    local Targets = {playerToFling}

    local AllBool = false

    local SkidFling = function(TargetPlayer)
        local Character = player.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Humanoid and Humanoid.RootPart

        local TCharacter = TargetPlayer.Character
        local THumanoid
        local TRootPart
        local THead
        local Accessory
        local Handle

        if not TCharacter then return end

        if TCharacter:FindFirstChildOfClass("Humanoid") then
            THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
        end
        if THumanoid and THumanoid.RootPart then
            TRootPart = THumanoid.RootPart
        end
        if TCharacter:FindFirstChild("Head") then
            THead = TCharacter.Head
        end
        if TCharacter:FindFirstChildOfClass("Accessory") then
            Accessory = TCharacter:FindFirstChildOfClass("Accessory")
        end
        if Accessory and Accessory:FindFirstChild("Handle") then
            Handle = Accessory.Handle
        end

        if Character and Humanoid and RootPart then
            if RootPart.Velocity.Magnitude < 50 then
                getgenv().OldPos = RootPart.CFrame
            end

            if THead then
                if THead.Velocity.Magnitude > 500 then
                    if fu and fu.dialog then
                        fu.dialog("Player flung", "Player is already flung. Fling again?", {"Fling again", "No"})
                        if fu.waitfordialog() == "No" then return fu.closedialog() end
                        fu.closedialog()
                    end
                end
            elseif not THead and Handle then
                if Handle.Velocity.Magnitude > 500 then
                    if fu and fu.dialog then
                        fu.dialog("Player flung", "Player is already flung. Fling again?", {"Fling again", "No"})
                        if fu.waitfordialog() == "No" then return fu.closedialog() end
                        fu.closedialog()
                    end
                end
            end

            if THead then
                workspace.CurrentCamera.CameraSubject = THead
            elseif not THead and Handle then
                workspace.CurrentCamera.CameraSubject = Handle
            elseif THumanoid and TRootPart then
                workspace.CurrentCamera.CameraSubject = THumanoid
            end

            if not TCharacter:FindFirstChildWhichIsA("BasePart") then
                return
            end

            local FPos = function(BasePart, Pos, Ang)
                RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
                Character:PivotTo(CFrame.new(BasePart.Position) * Pos * Ang)
                RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            end

            local SFBasePart = function(BasePart)
                local TimeToWait = 2
                local Time = tick()
                local Angle = 0

                repeat
                    if RootPart and THumanoid then
                        if BasePart.Velocity.Magnitude < 50 then
                            Angle = Angle + 100

                            FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle),0 ,0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(2.25, 1.5, -2.25) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(-2.25, -1.5, 2.25) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection,CFrame.Angles(math.rad(Angle), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection,CFrame.Angles(math.rad(Angle), 0, 0))
                            task.wait()
                        else
                            FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, 1.5, TRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, -TRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(0, 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, 1.5, TRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5 ,0), CFrame.Angles(math.rad(-90), 0, 0))
                            task.wait()

                            FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                            task.wait()
                        end
                    else
                        break
                    end
                until BasePart.Velocity.Magnitude > 500 or BasePart.Parent ~= TargetPlayer.Character or TargetPlayer.Parent ~= Players or TargetPlayer.Character ~= TCharacter or THumanoid.Sit or Humanoid.Health <= 0 or tick() > Time + TimeToWait
            end

            getgenv().FPDH = workspace.FallenPartsDestroyHeight
            workspace.FallenPartsDestroyHeight = -500

            local BV = Instance.new("BodyVelocity")
            BV.Name = "EpixVel"
            BV.Parent = RootPart
            BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
            BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)

            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

            if TRootPart and THead then
                if (TRootPart.CFrame.p - THead.CFrame.p).Magnitude > 5 then
                    SFBasePart(THead)
                else
                    SFBasePart(TRootPart)
                end
            elseif TRootPart and not THead then
                SFBasePart(TRootPart)
            elseif not TRootPart and THead then
                SFBasePart(THead)
            elseif not TRootPart and not THead and Accessory and Handle then
                SFBasePart(Handle)
            else
                WindUI:Notify({
                    Title = "Eclipse X",
                    Content = "Can't find a proper part of target player to fling.",
                    Duration = 3
                })
            end

            BV:Destroy()
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            workspace.CurrentCamera.CameraSubject = Humanoid

            repeat
                if getgenv().OldPos then
                    RootPart.CFrame = getgenv().OldPos * CFrame.new(0, .5, 0)
                    Character:PivotTo(getgenv().OldPos * CFrame.new(0, .5, 0))
                end
                Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                for _, x in ipairs(Character:GetChildren()) do
                    if x:IsA("BasePart") then
                        x.Velocity, x.RotVelocity = Vector3.new(), Vector3.new()
                    end
                end
                task.wait()
            until not getgenv().OldPos or (RootPart.Position - getgenv().OldPos.p).Magnitude < 25

            if getgenv().FPDH then
                workspace.FallenPartsDestroyHeight = getgenv().FPDH
            end
        else
            WindUI:Notify({
                Title = "Eclipse X",
                Content = "No valid character of said target player. May have died.",
                Duration = 3
            })
        end
    end

    SkidFling(Targets[1])
end

