-- =======================================================
-- دالة جلب المسدس مباشرة إلى بطن الشخصية
-- =======================================================
local function BringGunToStomach()
    local character = LocalPlayer.Character
    if not character then return end

    -- تحديد منطقة البطن (UpperTorso أو HumanoidRootPart)
    local stomachPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
    if not stomachPart then return end

    -- البحث عن البارت المغناطيسي للمسدس الساقط
    local gunPart = workspace:FindFirstChild("GunDrop", true) or workspace:FindFirstChild("GunDrob", true)
    if not gunPart then return end

    -- جلب السلاح فوراً إلى موقع البطن
    if gunPart:IsA("BasePart") then
        gunPart.CFrame = stomachPart.CFrame
    elseif gunPart:IsA("Model") then
        gunPart:PivotTo(stomachPart.CFrame)
    end
end

